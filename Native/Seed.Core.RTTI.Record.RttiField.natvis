<?xml version="1.0" encoding="utf-8"?> 
<AutoVisualizer xmlns="http://schemas.microsoft.com/vstudio/debugger/natvis/2010">
	<Type Name="Seed::Core::RTTI::Record::RttiField">
		<DisplayString Condition="it.item != nullptr">{{ Field = {((const Seed::Core::RTTI::MetaData::FieldMetaData*) it.item)->FieldName.Text,sub} }}</DisplayString>
		<DisplayString Condition="it.item == nullptr">{{ Invalid RttiField }}</DisplayString>
		<Expand>
			<Item Condition="it.item != nullptr" Name="Name">((const Seed::Core::RTTI::MetaData::FieldMetaData*) it.item)->FieldName.Text,sub</Item>
			<Item Condition="it.item != nullptr" Name="FullTypeId">((const Seed::Core::RTTI::MetaData::FieldMetaData*) it.item)->TypeId.Id</Item>
			<Item Condition="it.item != nullptr" Name="TypeClass">((const Seed::Core::RTTI::MetaData::FieldMetaData*) it.item)->TypeClass,en</Item>
			<Item Condition="it.item != nullptr" Name="Offset">((const Seed::Core::RTTI::MetaData::FieldMetaData*) it.item)->Offset</Item>
			<Item Condition="it.item != nullptr" Name="FieldId">it.idx</Item>
		</Expand>
	</Type>
</AutoVisualizer>
