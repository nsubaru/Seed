<?xml version="1.0" encoding="utf-8"?>
<AutoVisualizer xmlns="http://schemas.microsoft.com/vstudio/debugger/natvis/2010">
  <Type Name="Seed::Core::Containers::BaseList&lt;*, *&gt;">
    <DisplayString>{{ Lenght={This->size} RefCount={This->RefCount.count} }}</DisplayString>
    <Expand>
      <Item Name="[Reference count]">This->RefCount.count</Item>
      <Item Name="[Lenght]">This->size</Item>
      <LinkedListItems>
        <Size>This->size.count</Size>
        <HeadPointer>This->root</HeadPointer>
        <NextPointer>next</NextPointer>
        <ValueNode>value</ValueNode>
      </LinkedListItems>
    </Expand>
  </Type>
</AutoVisualizer>