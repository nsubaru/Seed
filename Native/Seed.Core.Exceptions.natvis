<?xml version="1.0" encoding="utf-8"?> 
<AutoVisualizer xmlns="http://schemas.microsoft.com/vstudio/debugger/natvis/2010">
  <Type Name="Seed::Core::Exceptions::Exception::ExeptionLocation">
    <DisplayString>{{{FunctName.str, na}:{Line} at {File.str, na} in thread {ThreadID}}}</DisplayString>
    <Expand>
      <Item Name="File">File.str, na</Item>
      <Item Name="Function">FunctName.str, na</Item>
      <Item Name="Line">Line</Item>
      <Item Name="Thread ID">ThreadID</Item>
    </Expand>
  </Type>
  <Type Name="Seed::Core::Exceptions::Exception" Inheritable="true">
    <DisplayString>{{Exception: {exceptionName.str, na}}}</DisplayString>
    <Expand>
      <Item Name="Name">exceptionName.str, su</Item>
      <ExpandedItem>location</ExpandedItem>
      <Item Name="StackTrace">stackTrace</Item>
    </Expand>
  </Type>
  <Type Name="Seed::Core::Exceptions::Exception::StackTraceRecord">
    <DisplayString>{{StackTrace}}</DisplayString>
    <Expand>
      <Item Name="Count">Count</Item>
      <ExpandedItem>FunctionAddress,[Count]stackTrace</ExpandedItem>
    </Expand>
  </Type>
</AutoVisualizer>