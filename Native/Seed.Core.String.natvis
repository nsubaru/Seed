<?xml version="1.0" encoding="utf-8"?> 
<AutoVisualizer xmlns="http://schemas.microsoft.com/vstudio/debugger/natvis/2010">
  <Type Name="Seed::Core::BaseString&lt;*&gt;">
    <DisplayString>{{ Lenght={CurrentSize} Text = {str == nullptr ? "nullptr" : str, su} }}</DisplayString>
    <StringView>str, su</StringView>
    <Expand>
      <Item Name="Lenght">CurrentSize</Item>
      <Item Name="Capacity">ReservedSize</Item>
      <ArrayItems>
        <Size>CurrentSize</Size>
        <ValuePointer>str</ValuePointer>
      </ArrayItems>
    </Expand>
  </Type>
</AutoVisualizer>