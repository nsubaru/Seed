<?xml version="1.0" encoding="utf-8"?>
<AutoVisualizer xmlns="http://schemas.microsoft.com/vstudio/debugger/natvis/2010">
  <Type Name="Seed::Core::Containers::BaseConcurrencyFixedQueue&lt;*, *, *&gt;">
    <DisplayString>{{ Count={count.count}, Capacity={$T2}, Front={front}, Rear={rear} }}</DisplayString>
    <Expand>
      <Item Name="[Count]">count.count</Item>
      <Item Name="[Capacity]">$T2</Item>
      <Item Name="[Front index]">front</Item>
      <Item Name="[Rear index]">rear</Item>
      <IndexListItems>
        <Size>count.count</Size>
        <ValueNode>queue[(front + $i) % $T2]</ValueNode>
      </IndexListItems>
    </Expand>
  </Type>
</AutoVisualizer>