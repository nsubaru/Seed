<?xml version="1.0" encoding="utf-8"?> 
<AutoVisualizer xmlns="http://schemas.microsoft.com/vstudio/debugger/natvis/2010">
	<Type Name="Seed::Core::RTTI::Record::RttiMethodRecord">
		<DisplayString Condition="it.item != nullptr">{{ Method = {((const Seed::Core::RTTI::MetaData::MethodMetaData*) it.item)->MethodName.Text,sub} }}</DisplayString>
		<DisplayString Condition="it.item == nullptr">{{ Invalid RttiMethodRecord }}</DisplayString>
		<Expand>
			<Item Condition="it.item != nullptr" Name="Name">((const Seed::Core::RTTI::MetaData::MethodMetaData*) it.item)->MethodName.Text,sub</Item>
			<Item Condition="it.item != nullptr" Name="CvRefModificators">((const Seed::Core::RTTI::MetaData::MethodMetaData*) it.item)->MethodCVRefModificators</Item>
			<Item Condition="it.item != nullptr" Name="IsAsync">((const Seed::Core::RTTI::MetaData::MethodMetaData*) it.item)->IsAsync</Item>
			<Item Condition="it.item != nullptr" Name="MethodId">it.idx</Item>
		</Expand>
	</Type>
</AutoVisualizer>
