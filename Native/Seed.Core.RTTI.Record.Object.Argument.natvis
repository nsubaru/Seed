			<Item Condition="it.item != nullptr" Name="TypeClass">((const Seed::Core::RTTI::MetaData::ArgumentMetaData*) it.item)->TypeClass,en</Item>
			<Item Condition="it.item != nullptr" Name="Flags">((const Seed::Core::RTTI::MetaData::ArgumentMetaData*) it.item)->Flags</Item>
			<Item Condition="it.item != nullptr" Name="ArgumentId">it.idx</Item>
		</Expand>
