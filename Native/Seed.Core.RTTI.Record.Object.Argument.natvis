	<Type Name="Seed::Core::RTTI::Record::RttiArgumentRecord">
		<DisplayString Condition="it.item != nullptr">{{ Argument = {((const Seed::Core::RTTI::MetaData::ArgumentMetaData*) it.item)->TypeName.Text,sub} }}</DisplayString>
