<?xml version="1.0" encoding="utf-8"?> 
<AutoVisualizer xmlns="http://schemas.microsoft.com/vstudio/debugger/natvis/2010">
  <Type Name="Seed::Core::RTTI::RttiTypeRecord">
    <DisplayString>{{RTTITypeRecord {data->rttiTypeInfo, na}}}</DisplayString>
    <Expand>
      <Item Name="RttiTypeId">data->rttiTypeInfo</Item>
      <Item Name="TypeId">data->TypeId</Item>
      <Item Name="DecayTypeId">data->DecayTypeId</Item>
      <Item Name="Name">data->TypeName</Item>
      <Item Name="CxxName">data->CxxTypeName</Item>
      <Item Name="TypeClass">data->TypeClass</Item>
      <Item Name="IsSerializeable">data->IsSerializeable</Item>
    </Expand>
  </Type>
</AutoVisualizer>