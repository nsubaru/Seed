<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType><TargetFramework>net10.0-windows10.0.26100.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings><Nullable>enable</Nullable><IsPackable>false</IsPackable>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../../Lib/Seed.E2E.Infrastructure/Seed.E2E.Infrastructure.csproj" />
    <ProjectReference Include="../../PublicAPI/Seed.RTTI/Seed.RTTI.csproj" />
  </ItemGroup>
  <Target Name="StageNativeStarter" AfterTargets="Build">
    <Copy SourceFiles="../../Artifacts/x64/$(Configuration)/API/Starter/Seed.Starter.dll" DestinationFolder="$(TargetDir)" />
    <Copy SourceFiles="../../Artifacts/x64/$(Configuration)/API/Starter/Seed.Starter.pdb" DestinationFolder="$(TargetDir)" Condition="Exists('../../Artifacts/x64/$(Configuration)/API/Starter/Seed.Starter.pdb')" />
  </Target>
</Project>
